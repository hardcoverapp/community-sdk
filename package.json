{
  "name": "hardcover-sdk-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "codegen": "pnpm -r codegen",
    "validate:operations": "node scripts/validate-operations.mjs",
    "matrix": "node scripts/render-matrix.mjs",
    "matrix:check": "node scripts/render-matrix.mjs --check",
    "playground": "pnpm --filter @hardcover/sdk-playground dev",
    "snapshot:check": "node scripts/snapshot.mjs",
    "snapshot:refresh": "node scripts/snapshot.mjs --write"
  },
  "devDependencies": {
    "graphql": "^17.0.2"
  },
  "packageManager": "pnpm@11.5.2"
}
