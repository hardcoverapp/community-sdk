[
  {
    "id": "errors/invalid-token",
    "covers": [
      "errors"
    ],
    "call": {
      "op": "Me",
      "variables": {}
    },
    "responses": [
      {
        "status": 401,
        "headers": {
          "www-authenticate": "Bearer realm=\"hardcover\", error=\"invalid_token\""
        },
        "body": {
          "error": "invalid_token",
          "error_description": "The access token is invalid or has expired"
        }
      }
    ],
    "expect": {
      "requests": 1,
      "result": {
        "error": "AuthenticationError"
      }
    }
  },
  {
    "id": "errors/insufficient-scope",
    "covers": [
      "errors"
    ],
    "call": {
      "op": "GetLibrary",
      "variables": {
        "userId": 1
      }
    },
    "responses": [
      {
        "status": 403,
        "body": {
          "error": "insufficient_scope",
          "error_description": "Missing scopes: read:library",
          "scope": "read:library"
        }
      }
    ],
    "expect": {
      "requests": 1,
      "result": {
        "error": "ScopeError",
        "fields": {
          "missingScopes": [
            "read:library"
          ],
          "operationName": "GetLibrary",
          "status": 403
        }
      }
    }
  },
  {
    "id": "errors/insufficient-scope-several",
    "covers": [
      "errors"
    ],
    "call": {
      "op": "UpdateUserBook",
      "variables": {
        "id": 1,
        "object": {
          "status_id": 3,
          "review_markdown": "Loved it"
        }
      }
    },
    "responses": [
      {
        "status": 403,
        "headers": {
          "www-authenticate": "Bearer realm=\"hardcover\", error=\"insufficient_scope\", scope=\"write:library write:reviews\""
        },
        "body": {
          "error": "insufficient_scope",
          "error_description": "Missing scopes: write:library write:reviews",
          "scope": "write:library write:reviews"
        }
      }
    ],
    "expect": {
      "requests": 1,
      "result": {
        "error": "ScopeError",
        "fields": {
          "missingScopes": [
            "write:library",
            "write:reviews"
          ],
          "operationName": "UpdateUserBook"
        }
      }
    }
  },
  {
