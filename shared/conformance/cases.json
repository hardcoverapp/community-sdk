  {
    "id": "errors/request-too-large",
    "covers": [
      "errors"
    ],
    "call": {
      "op": "raw",
      "query": "query { a: me { id } b: me { id } }"
    },
    "responses": [
      {
        "status": 403,
        "body": {
          "errors": [
            "request_exceeds_capacity"
          ],
          "message": "Request has 11 top-level fields; limit is 10"
        }
      }
    ],
    "expect": {
      "requests": 1,
      "result": {
        "error": "RequestTooLargeError"
      }
    }
  }
