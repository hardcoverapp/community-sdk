  {
    "id": "rate-limit/retry-after",
    "covers": [
      "rate-limit"
    ],
    "call": {
      "op": "Me",
      "variables": {}
    },
    "client": {
      "maxRetries": 2
    },
    "responses": [
      {
        "status": 429,
        "headers": {
          "retry-after": "3",
          "ratelimit": "\"Free\";r=0;t=3, \"daily\";r=4000;t=50000"
        },
        "body": {
          "error": "Too Many Requests",
          "message": "Rate limit exceeded"
        }
      },
      {
        "status": 200,
        "body": {
          "data": {
            "me": []
          }
        }
      }
    ],
    "expect": {
      "requests": 2,
      "sleptSeconds": [
        3
      ],
      "result": "ok"
    }
  },
  {
    "id": "rate-limit/gives-up",
    "covers": [
      "rate-limit"
    ],
    "call": {
      "op": "Me",
      "variables": {}
    },
    "client": {
      "maxRetries": 1
    },
    "responses": [
      {
        "status": 429,
        "headers": {
          "retry-after": "1"
        },
        "body": {
          "error": "Too Many Requests"
        }
      },
      {
        "status": 429,
        "headers": {
          "retry-after": "1"
        },
        "body": {
          "error": "Too Many Requests"
        }
      }
    ],
    "expect": {
      "requests": 2,
      "sleptSeconds": [
        1
      ],
      "result": {
        "error": "RateLimitError",
        "fields": {
          "retryAfterSeconds": 1
        }
      }
    }
  },
  {
    "id": "rate-limit/daily-not-retried",
    "covers": [
      "rate-limit"
    ],
    "call": {
      "op": "Me",
      "variables": {}
    },
    "client": {
      "maxRetries": 3
    },
    "responses": [
      {
        "status": 429,
        "headers": {
          "retry-after": "40000",
          "ratelimit": "\"daily\";r=0;t=40000"
        },
        "body": {
          "error": "Too Many Requests"
        }
      }
    ],
    "expect": {
      "requests": 1,
